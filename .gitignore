# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local Claude Code state (session dirs, worktrees, settings) is machine-specific
# and stays out of the repo -- but `.claude/skills/` is project documentation we
# want versioned and shared, so it is re-included below. Note the trailing `/*`:
# with a plain `.claude/` git never descends into the directory and a negation
# for a path inside it can never match.
.claude/*
!.claude/skills/
.agents/
skills-lock.json

# Test-only AR fixture, staged here by tool/drive_ar_seg.sh for the duration
# of one integration-test run. It lives un-bundled in test_fixtures/ so it
# never ships in a production build — never commit it back under assets/.
/assets/test/
# Symlink into the gitignored .agents/ skill cache -- tracking it would leave a
# dangling link in a fresh clone. Real, self-contained skills stay versioned.
.claude/skills/supabase-server
